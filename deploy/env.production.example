# =============================================================================
#  生产环境变量模板 —— 复制到 /opt/portfolio/deploy/portfolio.env 后填写
#
#    cp /opt/portfolio/deploy/env.production.example /opt/portfolio/deploy/portfolio.env
#    chmod 600 /opt/portfolio/deploy/portfolio.env      # 含密码，务必收紧权限
#
#  systemd EnvironmentFile 格式要求（很重要，写错会启不来）：
#    · 一行一个 KEY=VALUE，不要写 export
#    · 值不要用引号包裹
#    · 值里别出现空格、$、` 等 shell 元字符
#    · 生成密钥请用 hex，避免 base64 里的 + / = 引起解析歧义：
#        openssl rand -hex 48
# =============================================================================

# ---------------------------- MySQL 8（主存储）----------------------------
# 服务器本机 MySQL 默认 3306；注意后端 application.yml 的默认兜底是 3307，
# 所以这里必须显式写 3306，否则会连不上。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=Cyan
MYSQL_USER=yc_app
MYSQL_PASSWORD=改成强密码-至少16位

# 建表策略：
#   首次部署用 update（自动建表并对齐实体）
#   稳定运行后改成 validate（只校验不改动，避免误改生产表结构）
JPA_DDL=update

# ---------------------------- Redis（缓存层）----------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=改成强密码-至少16位
REDIS_DB=0

# ---------------------------- 应用缓存 ----------------------------
APP_KEY_PREFIX=yc:
APP_CACHE_ENABLED=true
APP_CACHE_TTL=300

# ---------------------------- JWT ----------------------------
# 生成：openssl rand -hex 48
JWT_SECRET=把这里换成openssl-rand-hex-48的输出
JWT_ACCESS_TTL=7200
JWT_REMEMBER_TTL=1209600

# ---------------------------- 登录防护 / 限流 ----------------------------
LOGIN_MAX_FAILED=5
LOGIN_LOCK_SECONDS=900
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=120

# ---------------------------- CORS ----------------------------
# 走 Nginx 反向代理时前后端同源，这里填正式访问地址即可
APP_CORS_ORIGINS=https://你的域名

# ---------------------------- 文件上传 ----------------------------
# 必须用绝对路径！相对路径会跟着 Java 进程工作目录解析，
# 换目录启动会导致素材"消失"（实际写到别处，/media/ 全部 404）。
# 该目录要与 deploy/nginx.conf 里 /media/ 的 alias 保持一致。
APP_UPLOAD_DIR=/var/lib/portfolio/upload

# ---------------------------- 初始管理员（仅首次播种生效）----------------------------
# 首次启动会自动创建这个账号；播种完成后请把密码改掉，并从该文件里删掉这两行。
ADMIN_USERNAME=Cyan
ADMIN_PASSWORD=改成强密码

# ---------------------------- 健康检查 ----------------------------
# Linux 下 Redis 的 INFO 路径是正斜杠，可以安全开启 Redis 健康探针
MANAGEMENT_HEALTH_REDIS_ENABLED=true

# ---------------------------- 端口（可选）----------------------------
# 后端默认 8080，与 nginx.conf 的 proxy_pass 对应；改这里就要同步改 nginx
# SERVER_PORT=8080
