# ================= secrets =================
.env
.env.local
*.env.local
server/src/main/resources/application-prod.yml

# ================= Java =================
target/
*.class
*.jar
!server/**/*.jar
.mvn/
mvnw
mvnw.cmd

# ================= Node =================
node_modules/
web/dist/
web/.vite/
*.local

# ================= build artifacts =================
# 打包产物是构建输出，不是源码：进仓库会不断膨胀且夹带本机路径/配置
*.zip
deploy.zip
portfolio-deploy-package.zip

# ================= data =================
# 站点内容与素材都在容器卷里，绝不进仓库（重新部署才不会覆盖线上数据）
data/
*.log
/backup/
/_smoke/
/uploads/

# 本机会话/记忆数据，与项目无关，绝不进仓库
.workbuddy/

# ================= local toolchain / OS =================
.toolchain/
C:/Users/Administrator/.toolchain/
.DS_Store
Thumbs.db
desktop.ini

# ================= IDE =================
.idea/
.vscode/*
!.vscode/settings.json
*.iml
